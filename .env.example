# ==============================================================================
# Halal Dine Environment Variables
# Copy to .env for local development
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database & PostGIS (Docker Compose / Managed PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=halal_dine
DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/halal_dine?schema=public"

# ------------------------------------------------------------------------------
# Backend API (NestJS)
# ------------------------------------------------------------------------------
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Authentication & JWT
JWT_SECRET=super_secret_jwt_access_key_halal_dine_development_only_min_32_bytes
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_ISSUER=halal-dine-api
JWT_AUDIENCE=halal-dine-clients

# Refresh Token & Web Cookie Configuration
REFRESH_TOKEN_EXPIRY_DAYS=7
REFRESH_COOKIE_NAME=halal_dine_refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_CSRF_COOKIE_NAME=halal_dine_csrf_token
ROTATED_TOKEN_RETENTION_DAYS=30
SESSION_CLEANUP_RETENTION_DAYS=30
EMAIL_TOKEN_CLEANUP_RETENTION_DAYS=7
PASSWORD_RESET_CLEANUP_RETENTION_DAYS=7
SESSION_CLEANUP_BATCH_SIZE=500
SESSION_CLEANUP_CRON="0 */6 * * *"

# ------------------------------------------------------------------------------
# Email, Verification & Password Recovery (SMTP / Configurable Provider)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="Halal Dine <noreply@halaldine.in>"
EMAIL_VERIFICATION_URL_BASE=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRY_HOURS=24
# Supports web page URL or HTTPS Universal/App Link shared by web & mobile (appends ?token=...)
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_VERIFICATION_THROTTLE_LIMIT=3
RESEND_VERIFICATION_THROTTLE_TTL_MS=60000

# ------------------------------------------------------------------------------
# Rate Limiting (Throttling)
# ------------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
AUTH_REGISTER_THROTTLE_LIMIT=5
AUTH_REGISTER_THROTTLE_TTL_MS=60000
AUTH_LOGIN_THROTTLE_LIMIT=5
AUTH_LOGIN_THROTTLE_TTL_MS=60000
AUTH_REFRESH_THROTTLE_LIMIT=20
AUTH_REFRESH_THROTTLE_TTL_MS=60000
AUTH_VERIFY_EMAIL_THROTTLE_LIMIT=10
AUTH_VERIFY_EMAIL_THROTTLE_TTL_MS=60000
AUTH_FORGOT_PASSWORD_THROTTLE_LIMIT=3
AUTH_FORGOT_PASSWORD_THROTTLE_TTL_MS=60000
AUTH_FORGOT_PASSWORD_EMAIL_LIMIT=3
AUTH_FORGOT_PASSWORD_EMAIL_WINDOW_MINUTES=15
AUTH_RESET_PASSWORD_THROTTLE_LIMIT=5
AUTH_RESET_PASSWORD_THROTTLE_TTL_MS=60000
AUTH_CHANGE_PASSWORD_THROTTLE_LIMIT=5
AUTH_CHANGE_PASSWORD_THROTTLE_TTL_MS=60000

# ------------------------------------------------------------------------------
# Web Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Mobile App (Expo / React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# AWS S3 Storage (Optional in Phase 1)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BUCKET_NAME=halal-dine-public-assets
AWS_SECURE_BUCKET_NAME=halal-dine-secure-documents

