# ==============================================================================
# Halal Dine Environment Variables
# Copy to .env for local development
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database & PostGIS (Docker Compose / Managed PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=halal_dine
DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/halal_dine?schema=public"

# ------------------------------------------------------------------------------
# Backend API (NestJS)
# ------------------------------------------------------------------------------
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Authentication & JWT (Task 4 ready)
JWT_SECRET=super_secret_jwt_access_key_halal_dine_development_only_min_32_bytes
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_ISSUER=halal-dine-api
JWT_AUDIENCE=halal-dine-clients

# ------------------------------------------------------------------------------
# Email & Verification (SMTP / Configurable Provider)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="Halal Dine <noreply@halaldine.in>"
EMAIL_VERIFICATION_URL_BASE=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_VERIFICATION_THROTTLE_LIMIT=3
RESEND_VERIFICATION_THROTTLE_TTL_MS=60000

# ------------------------------------------------------------------------------
# Rate Limiting (Throttling)
# ------------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
AUTH_REGISTER_THROTTLE_LIMIT=5
AUTH_REGISTER_THROTTLE_TTL_MS=60000
AUTH_VERIFY_EMAIL_THROTTLE_LIMIT=10
AUTH_VERIFY_EMAIL_THROTTLE_TTL_MS=60000

# ------------------------------------------------------------------------------
# Web Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Mobile App (Expo / React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# AWS S3 Storage (Optional in Phase 1)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PUBLIC_BUCKET_NAME=halal-dine-public-assets
AWS_SECURE_BUCKET_NAME=halal-dine-secure-documents

