generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  VERIFIER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OwnerRole {
  PRIMARY_OWNER
  MANAGER
}

enum HalalVerificationStatus {
  UNVERIFIED
  RESTAURANT_CLAIMS_HALAL
  VERIFICATION_PENDING
  VERIFIED_HALAL
  VERIFICATION_EXPIRED
  REPORT_UNDER_REVIEW
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_NEEDED
}

enum VerificationCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  phone           String?           @unique
  name            String
  passwordHash    String
  role            UserRole          @default(CUSTOMER)
  status          UserStatus        @default(ACTIVE)
  isEmailVerified Boolean           @default(false)
  isPhoneVerified Boolean           @default(false)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  avatarUrl       String?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  restaurantOwners        RestaurantOwner[]
  ownershipClaims   OwnershipClaim[]   @relation("ClaimantUser")
  reviewedClaims    OwnershipClaim[]   @relation("ReviewerUser")
  verificationCases VerificationCase[] @relation("ApplicantUser")
  verifiedCases     VerificationCase[] @relation("VerifierUser")
  verificationEvents VerificationEvent[] @relation("ActorUser")
  favorites         Favorite[]
  reports           RestaurantReport[]
  auditLogs         AuditLog[]

  @@index([role])
  @@index([status])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceInfo       String?
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedTokens RotatedRefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model RotatedRefreshToken {
  id        String   @id @default(uuid())
  sessionId String
  tokenHash String   @unique
  rotatedAt DateTime @default(now())
  expiresAt DateTime

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
}

model Restaurant {
  id                  String                  @id @default(uuid())
  slug                String                  @unique
  name                String
  description         String?
  address             String
  city                String
  district            String                  // e.g. Kozhikode, Ernakulam, Malappuram
  state               String                  @default("Kerala")
  postalCode          String?
  country             String                  @default("India")
  phone               String?
  email               String?
  website             String?
  latitude            Float
  longitude           Float
  location            Unsupported("geometry(Point, 4326)")?
  openingHours        Json?
  coverImageUrl       String?
  googlePlaceId       String?                 @unique
  externalRating      Float?
  externalReviewCount Int?
  halalStatus         HalalVerificationStatus @default(UNVERIFIED)
  isClaimed           Boolean                 @default(false)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  owners              RestaurantOwner[]
  ownershipClaims     OwnershipClaim[]
  verificationCases   VerificationCase[]
  verificationEvents  VerificationEvent[]
  images              RestaurantImage[]
  menuCategories      MenuCategory[]
  favorites           Favorite[]
  reports             RestaurantReport[]

  @@index([district])
  @@index([city])
  @@index([halalStatus])
  @@index([isActive])
  @@index([location], map: "restaurant_location_gist_idx", type: Gist)
}

model RestaurantOwner {
  id           String     @id @default(uuid())
  restaurantId String
  userId       String
  role         OwnerRole  @default(PRIMARY_OWNER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
  @@index([restaurantId])
}

model OwnershipClaim {
  id                         String      @id @default(uuid())
  restaurantId               String
  claimantUserId             String
  businessRegistrationNumber String?     // GSTIN, FSSAI, or trade license
  documentUrls               String[]
  contactPhone               String
  contactEmail               String
  status                     ClaimStatus @default(PENDING)
  reviewerUserId             String?
  reviewerNotes              String?
  submittedAt                DateTime    @default(now())
  reviewedAt                 DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  claimant   User       @relation("ClaimantUser", fields: [claimantUserId], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("ReviewerUser", fields: [reviewerUserId], references: [id])

  @@index([restaurantId])
  @@index([claimantUserId])
  @@index([status])
}

model VerificationCase {
  id                  String                 @id @default(uuid())
  restaurantId        String
  applicantUserId     String
  status              VerificationCaseStatus @default(SUBMITTED)
  assignedVerifierId  String?
  validityStartDate   DateTime?
  validityEndDate     DateTime?
  reviewerNotes       String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  applicant  User                   @relation("ApplicantUser", fields: [applicantUserId], references: [id])
  verifier   User?                  @relation("VerifierUser", fields: [assignedVerifierId], references: [id])
  evidence   VerificationEvidence[]

  @@index([restaurantId])
  @@index([applicantUserId])
  @@index([status])
}

model VerificationEvidence {
  id                 String           @id @default(uuid())
  verificationCaseId String
  documentType       String           // CERTIFICATE, SUPPLIER_INVOICE, ON_SITE_AUDIT, AFFIDAVIT
  fileUrl            String           // Private S3 key
  fileMimeType       String
  fileSize           Int
  issuedBy           String?
  issueDate          DateTime?
  expiryDate         DateTime?
  isVerified         Boolean          @default(false)
  createdAt          DateTime         @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([verificationCaseId])
}

model VerificationEvent {
  id             String                  @id @default(uuid())
  restaurantId   String
  actorUserId    String?
  previousStatus HalalVerificationStatus
  newStatus      HalalVerificationStatus
  reason         String?
  metadata       Json?
  createdAt      DateTime                @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ActorUser", fields: [actorUserId], references: [id])

  @@index([restaurantId])
  @@index([createdAt])
}

model RestaurantImage {
  id           String   @id @default(uuid())
  restaurantId String
  url          String
  caption      String?
  isCover      Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id              String       @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  price           Decimal      @db.Decimal(10, 2)
  isAvailable     Boolean      @default(true)
  isHalalVerified Boolean      @default(false)
  imageUrl        String?
  createdAt       DateTime     @default(now())

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
}

model RestaurantReport {
  id             String       @id @default(uuid())
  restaurantId   String
  reporterUserId String?
  reportType     String       // INCORRECT_INFO, NOT_HALAL, CLOSED, OTHER
  description    String
  status         ReportStatus @default(PENDING)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reporter   User?      @relation(fields: [reporterUserId], references: [id])

  @@index([restaurantId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityName String
  entityId   String?
  ipAddress  String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityName])
}

